{
	"name": "@realmag777/lynx",
	"version": "0.1.0",
	"description": "LYNX core: sandboxed EmDash plugin with jobs, history, rollback, Block Kit page and MCP tools.",
	"license": "MIT",
	"author": "Rostislav Sofronov (realmag777) (https://realmag777.com)",
	"homepage": "https://realmag777.com",
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc",
		"mcp-tools.frozen.json"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc -p tsconfig.json",
		"test": "emdash-plugin validate && vitest run && node tools/size.ts && node tools/freeze.ts",
		"size": "node tools/size.ts"
	},
	"peerDependencies": {
		"emdash": "^1.0.1"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "^1.0.1",
		"@emdash-cms/plugin-cli": "0.13.1",
		"@emdash-cms/plugin-test": "^0.2.6",
		"@realmag777/lynx-engine": "workspace:*",
		"@types/node": "^24.0.0",
		"emdash": "^1.0.1",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0",
		"zod": "4.5.4"
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"bulk-edit",
		"mcp",
		"ai-agent",
		"lynx"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/realmag777/lynx-emdash.git",
		"directory": "packages/plugin"
	},
	"bugs": {
		"url": "https://github.com/realmag777/lynx-emdash/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
